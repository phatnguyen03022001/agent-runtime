#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
cd "$ROOT"
if [[ -n "${PYTHON:-}" ]]; then
  PYTHON="$PYTHON"
elif [[ -x "$ROOT/.venv/bin/python" ]]; then
  PYTHON="$ROOT/.venv/bin/python"
else
  PYTHON="python3"
fi

"$PYTHON" -m py_compile verify_tests.py agent_runtime/*.py tests/*.py
bash -n install.sh
bash -n start.sh
bash -n verify
PYTHONPATH="$ROOT" "$PYTHON" "$ROOT/verify_tests.py" "$@"
