#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

python3 -m unittest discover -s tests -p 'test_*.py'
python3 -m py_compile \
  agent_runtime/__init__.py \
  agent_runtime/config.py \
  agent_runtime/git_ops.py \
  agent_runtime/state.py \
  agent_runtime/runner.py \
  agent_runtime/server.py

if grep -R --line-number --fixed-strings 'shell=True' agent_runtime; then
  echo 'Forbidden shell=True found.' >&2
  exit 1
fi
if grep -R --line-number --fixed-strings '"clean", "-fdx"' agent_runtime; then
  echo 'Forbidden git clean -fdx found.' >&2
  exit 1
fi
