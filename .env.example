# OpenAI Secure MCP Tunnel settings.
# Fill these in checkout .env before the first install. Never commit .env.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=

# Runtime-independent settings.
# The installer derives AGENT_RUNTIME_WORKSPACE_ROOT from the checkout location
# and writes that canonical value to runtime.env during first bootstrap.
AGENT_RUNTIME_WORKSPACE_ROOT=

# Runtime Git identity. Provide both values together. The installer can also
# source the pair from repository-local git user.name/user.email when canonical
# runtime.env has not yet been initialized.
# AGENT_RUNTIME_GIT_NAME=
# AGENT_RUNTIME_GIT_EMAIL=

# Persistent terminal-session capacity: integer 1 through 6.
AGENT_RUNTIME_MAX_ACTIVE_SESSIONS=6

# Heavy execution operator ceiling: integer 1 through 10. Runtime admission
# remains bounded by its frozen safe ceiling.
AGENT_RUNTIME_MAX_PARALLELISM=2
