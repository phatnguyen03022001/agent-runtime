# Trusted runtime profile configuration. Keep the real file outside Git.
AGENT_RUNTIME_CONFIG=/absolute/path/to/runtime.local.toml

# External tunnel-client profile name.
AGENT_RUNTIME_TUNNEL_PROFILE=agent-runtime

# Existing tunnel control-plane settings, if required by your tunnel-client deployment.
CONTROL_PLANE_API_KEY=
CONTROL_PLANE_TUNNEL_ID=
